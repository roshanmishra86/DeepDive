{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Deep Work",
  "version": "0.2.3",
  "identifier": "com.roshanmishra.deepwork",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Deep Work",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https: http:; media-src 'self' asset: http://asset.localhost blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "deb", "appimage"],
    "publisher": "roshanmishra86",
    "category": "Productivity",
    "shortDescription": "A desktop app for managing deep work sessions",
    "longDescription": "Deep Work is a desktop app for planning distraction-free work days: a proportional block timeline, pomodoro timer with a full-session focus mode, day templates, an archive of what actually landed, and a local sound library.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBQjlFRkY5MTc1RjU3QTYKUldTbVYxOFgrZSs1V3IwdU9TaDY2dlFBUTF1enRvQ05HS3F1NlF2WXdjSGtzelZSNlM5MklHSTkK",
      "endpoints": [
        "https://github.com/roshanmishra86/DeepDive/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
